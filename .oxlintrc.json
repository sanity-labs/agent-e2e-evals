{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "eslint/id-length": ["error", { "min": 2, "exceptions": ["i", "j", "_"], "properties": "never" }]
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": ["evals/*/**", "!evals/*/EVAL.ts", "!evals/*/EVAL.tsx", "published/**"]
}
